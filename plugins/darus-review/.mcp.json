{
  "mcpServers": {
    "darus-mcp": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/../..",
        "fastmcp",
        "run",
        "${CLAUDE_PLUGIN_ROOT}/../../main.py"
      ],
      "env": {
        "API_TOKEN": "${DARUS_API_TOKEN}",
        "ALLOW_WRITE": "${DARUS_ALLOW_WRITE:-}"
      }
    }
  }
}
