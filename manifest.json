{
  "manifest_version": "0.4",
  "name": "darus-mcp",
  "display_name": "DaRUS",
  "version": "0.3.0",
  "description": "Search, inspect and review DaRUS (University of Stuttgart Dataverse) datasets; optionally create and edit drafts.",
  "author": {
    "name": "SimTech Research Data Management"
  },
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/SimTech-Research-Data-Management/darus-mcp"
  },
  "server": {
    "type": "uv",
    "entry_point": "main.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${__dirname}",
        "fastmcp",
        "run",
        "main.py"
      ],
      "env": {
        "API_TOKEN": "${user_config.api_token}"
      }
    }
  },
  "user_config": {
    "api_token": {
      "type": "string",
      "title": "DaRUS API token",
      "description": "Optional. Without it Claude sees only published datasets. In DaRUS, open the menu under your name and choose API Token.",
      "sensitive": true,
      "required": false
    }
  },
  "compatibility": {
    "platforms": [
      "darwin",
      "win32"
    ],
    "runtimes": {
      "python": ">=3.12"
    }
  },
  "keywords": [
    "darus",
    "dataverse",
    "research-data",
    "fair"
  ]
}
